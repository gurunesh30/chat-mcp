# MCP Chat Memory Server — environment configuration example
# Copy this file to .env and fill in your values

# Path to the LanceDB storage directory (relative to project root)
LANCEDB_PATH=./storage/lancedb

# Directory to watch for exported chat files
EXPORTS_DIR=./exports

# Local embedding model (Xenova/transformers hub ID).
# all-MiniLM-L6-v2 runs fully offline (384-dim). Weights downloaded on first run.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Vector dimensionality — must match the model above
VECTOR_DIMENSIONS=384

# Maximum number of results returned by a single search query
SEARCH_TOP_K=10

# Log level: debug | info | warn | error
LOG_LEVEL=info
